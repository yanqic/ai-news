---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>">
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --bg-primary: #fafafa;
    --bg-secondary: #ffffff;
    --text-primary: #1a1a1a;
    --text-secondary: #666666;
    --accent-color: #0070f3;
    --border-color: #e1e4e8;
    --shadow: rgba(0, 0, 0, 0.1);
  }

  [data-theme="dark"] {
    --bg-primary: #0d1117;
    --bg-secondary: #161b22;
    --text-primary: #c9d1d9;
    --text-secondary: #8b949e;
    --accent-color: #58a6ff;
    --border-color: #30363d;
    --shadow: rgba(0, 0, 0, 0.3);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    line-height: 1.6;
    background: var(--bg-primary);
    color: var(--text-primary);
    transition: background 0.3s, color 0.3s;
  }

  h1 {
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 10px;
    color: var(--text-primary);
    font-size: 1.5em;
  }

  h2 {
    color: var(--text-primary);
    margin-top: 30px;
    padding: 10px;
    background: var(--bg-secondary);
    border-left: 4px solid var(--accent-color);
    font-size: 1.2em;
    border-radius: 4px;
  }

  .nav {
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
  }

  .nav a {
    color: var(--accent-color);
    text-decoration: none;
    font-size: 16px;
  }

  .nav a:hover { text-decoration: underline; }

  .theme-toggle {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    margin-left: auto;
  }

  .theme-toggle:hover { background: var(--border-color); }

  .source-tag { color: var(--text-secondary); font-size: 0.9em; font-weight: 500; }

  ul {
    list-style-type: none;
    padding: 0;
    background: var(--bg-secondary);
    border-radius: 8px;
    box-shadow: 0 1px 3px var(--shadow);
  }

  li {
    padding: 15px;
    border-bottom: 1px solid var(--border-color);
  }

  li:last-child { border-bottom: none; }

  .github-item {
    background: var(--bg-secondary);
    padding: 15px;
    border-radius: 6px;
    margin: 10px 0;
    border: 1px solid var(--border-color);
  }

  .github-item strong { color: var(--accent-color); }

  .stars { color: #f97316; font-weight: 500; }

  .footer {
    margin-top: 40px;
    padding: 20px;
    background: var(--bg-secondary);
    border-radius: 8px;
    color: var(--text-secondary);
    font-size: 0.85em;
    box-shadow: 0 1px 3px var(--shadow);
  }

  .footer a { color: var(--accent-color); }

  .back-link { margin-top: 20px; }

  .back-link a {
    color: var(--accent-color);
    text-decoration: none;
    display: inline-block;
    padding: 8px 0;
  }

  @media (max-width: 600px) {
    body { padding: 15px; }
    h1 { font-size: 1.3em; }
    h2 { font-size: 1.1em; }
    .nav { gap: 10px; }
    .theme-toggle { margin-left: 0; }
    .footer, ul { padding: 15px; }
    li, .github-item { padding: 12px; }
  }
</style>

<script>
function toggleTheme() {
  const html = document.documentElement;
  const btn = document.querySelector('.theme-toggle');
  if (html.getAttribute('data-theme') === 'dark') {
    html.removeAttribute('data-theme');
    btn.textContent = '🌙 暗色模式';
    localStorage.setItem('theme', 'light');
  } else {
    html.setAttribute('data-theme', 'dark');
    btn.textContent = '☀️ 亮色模式';
    localStorage.setItem('theme', 'dark');
  }
}

(function() {
  const saved = localStorage.getItem('theme');
  if (saved === 'dark') {
    document.documentElement.setAttribute('data-theme', 'dark');
  } else if (saved === 'light') {
    document.documentElement.removeAttribute('data-theme');
  } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
    document.documentElement.setAttribute('data-theme', 'dark');
  }
})();
</script>
