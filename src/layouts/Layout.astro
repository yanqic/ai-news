---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any">
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  /* ── Reset ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    /* Blenheim palette */
    --green-deep:    #001f1f;
    --green-line:    #465755;
    --green-light:   #1a312f;
    --cream:         #f9f4f0;
    --cream-dark:    #f0ebe5;
    --gold:          #bfb29c;
    --gold-dark:     #9d8465;
    --grey:          #c0c0c0;
    --red-tag:       #ae0909;

    /* Semantic */
    --bg-primary:    #ffffff;
    --bg-cream:      #f9f4f0;
    --bg-dark:       #001f1f;
    --text-primary:  #1a1a1a;
    --text-secondary:#6b6560;
    --text-muted:    #9a9590;
    --text-on-dark:  #f9f4f0;
    --text-gold:     #bfb29c;
    --accent:        #bfb29c;
    --border:        #e8e3de;
    --border-dark:   #465755;

    /* Fonts */
    --font-display: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --font-sans:    'Jost', 'Helvetica Neue', Arial, sans-serif;
    --font-weight-light: 300;
    --font-weight-regular: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;

    /* Spacing */
    --space-xs:  8px;
    --space-sm:  16px;
    --space-md:  24px;
    --space-lg:  40px;
    --space-xl:  64px;
    --space-2xl: 96px;

    /* Layout */
    --max-w:       1160px;
    --max-w-narrow: 800px;
    --nav-h: 68px;

    /* Radius */
    --radius-sm: 4px;
    --radius-md: 8px;

    /* Transitions */
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-regular);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.65;
    transition: background 0.25s var(--ease), color 0.25s var(--ease);
  }

  [data-theme="dark"] {
    --bg-primary: #0c1818;
    --bg-cream:   #122020;
    --text-primary: #f0ebe5;
    --text-secondary: #a8a39c;
    --text-muted: #6b6560;
    --border: #2a3534;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  /* ════════════════════════════════════════════
     NAVIGATION
  ════════════════════════════════════════════ */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: var(--bg-dark);
    border-bottom: 1px solid var(--green-line);
    display: flex;
    align-items: center;
  }

  .nav-inner {
    width: 100%;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--cream);
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .nav-brand-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
  }

  .nav-links a {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    transition: all 0.2s var(--ease);
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    right: 50%;
    height: 1px;
    background: var(--gold);
    transition: all 0.3s var(--ease);
  }

  .nav-links a:hover::after,
  .nav-links a.active::after {
    left: 12px;
    right: 12px;
  }

  .nav-links a:hover {
    color: var(--cream);
  }

  /* ════════════════════════════════════════════
     PAGE CONTAINER
  ════════════════════════════════════════════ */
  .page-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  /* ════════════════════════════════════════════
     HERO (dark section)
  ════════════════════════════════════════════ */
  .hero-section {
    background: var(--bg-dark);
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid var(--green-line);
  }

  .hero-inner {
    max-width: 680px;
  }

  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--space-sm);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--cream);
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-light);
    line-height: 1.7;
    color: var(--gold);
    max-width: 520px;
  }

  .hero-divider {
    width: 48px;
    height: 1px;
    background: var(--gold);
    margin: var(--space-md) 0;
  }

  /* ════════════════════════════════════════════
     FILTERS BAR (cream background)
  ════════════════════════════════════════════ */
  .filters-bar {
    background: var(--bg-cream);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--border);
  }

  .filters-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .filter-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .filter-pill {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s var(--ease);
  }

  .filter-pill:hover {
    border-color: var(--gold);
    color: var(--text-primary);
  }

  .filter-pill.active {
    background: var(--green-deep);
    border-color: var(--green-deep);
    color: var(--gold);
  }

  .view-toggle {
    display: flex;
    align-items: center;
    gap: 2px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px;
  }

  .view-toggle button {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    border-radius: 3px;
    cursor: pointer;
    color: var(--text-muted);
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s var(--ease);
  }

  .view-toggle button.active {
    background: var(--green-deep);
    color: var(--gold);
  }

  /* ════════════════════════════════════════════
     POSTS SECTION
  ════════════════════════════════════════════ */
  .posts-section {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .section-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .section-count {
    font-size: 0.8rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ─── Grid ─── */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* ─── Post Card ─── */
  .post-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s var(--ease);
  }

  .post-card:hover {
    border-color: var(--gold);
    box-shadow: 0 8px 32px rgba(0,31,31,0.1);
    transform: translateY(-3px);
    opacity: 1;
  }

  .post-card-image {
    height: 160px;
    background: var(--bg-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .post-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }

  .post-card-date {
    font-size: 0.72rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--text-primary);
    flex: 1;
  }

  .post-card-excerpt {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .post-card-sources {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .read-link {
    font-size: 0.72rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-dark);
    display: flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s var(--ease);
  }

  .post-card:hover .read-link {
    gap: 8px;
  }

  /* ─── List View ─── */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .post-list-item {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px 24px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s var(--ease);
    cursor: pointer;
  }

  .post-list-item:hover {
    border-color: var(--gold);
    background: var(--bg-cream);
    opacity: 1;
  }

  .post-list-item-date {
    font-size: 0.78rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-dark);
    min-width: 84px;
    flex-shrink: 0;
    font-family: var(--font-sans);
  }

  .post-list-item-title {
    flex: 1;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .post-list-item-arrow {
    color: var(--gold);
    font-size: 1rem;
    transition: transform 0.2s var(--ease);
    flex-shrink: 0;
  }

  .post-list-item:hover .post-list-item-arrow {
    transform: translateX(3px);
  }

  /* ════════════════════════════════════════════
     ARCHIVE PAGE
  ════════════════════════════════════════════ */
  .archive-hero {
    background: var(--bg-dark);
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid var(--green-line);
  }

  .archive-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 400;
    color: var(--cream);
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-bottom: var(--space-xs);
  }

  .archive-hero p {
    font-size: 0.875rem;
    color: var(--gold);
    font-weight: var(--font-weight-light);
  }

  .archive-section {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .archive-group {
    margin-bottom: var(--space-xl);
  }

  .archive-month-label {
    font-size: 0.7rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--border);
  }

  .archive-list {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .archive-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s var(--ease);
  }

  .archive-item:last-child { border-bottom: none; }

  .archive-item:hover {
    background: var(--bg-cream);
    padding-left: 32px;
    opacity: 1;
  }

  .archive-item:hover .archive-item-arrow {
    transform: translateX(3px);
    color: var(--gold);
  }

  .archive-item-date {
    font-size: 0.78rem;
    color: var(--gold-dark);
    font-weight: var(--font-weight-medium);
    min-width: 36px;
    flex-shrink: 0;
    font-family: var(--font-sans);
  }

  .archive-item-title {
    flex: 1;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    color: var(--text-primary);
  }

  .archive-item-cat {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    background: var(--green-deep);
    color: var(--gold);
    flex-shrink: 0;
  }

  .archive-item-cat.github {
    background: #2d1f00;
    color: #f0c040;
  }

  .archive-item-arrow {
    color: var(--text-muted);
    transition: all 0.2s var(--ease);
    flex-shrink: 0;
  }

  /* ════════════════════════════════════════════
     POST / ARTICLE PAGE
  ════════════════════════════════════════════ */
  .post-page {
    background: var(--bg-cream);
    min-height: 60vh;
  }

  .post-page-inner {
    max-width: var(--max-w-narrow);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg) var(--space-2xl);
  }

  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
    padding: 6px 0;
    transition: color 0.2s var(--ease);
  }

  .post-back:hover { color: var(--text-primary); }

  .post-header {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-lg);
  }

  .post-date {
    font-size: 0.72rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: var(--space-sm);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .post-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
    font-weight: var(--font-weight-light);
    margin: 0;
  }

  /* ─── Article body ─── */
  .post-body {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .post-body h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-top: 48px;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .post-body h3 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .post-body p {
    margin-bottom: 16px;
  }

  .post-body ul, .post-body ol {
    margin: 16px 0;
    padding-left: 22px;
  }

  .post-body li {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .post-body ul li::marker {
    color: var(--gold);
  }

  .post-body a {
    color: var(--gold-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--gold-dark) 40%, transparent);
    transition: text-decoration-color 0.2s;
  }

  .post-body a:hover {
    text-decoration-color: var(--gold-dark);
  }

  .post-body blockquote {
    border-left: 2px solid var(--gold);
    margin: 24px 0;
    padding: 14px 20px;
    background: var(--bg-primary);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
    font-style: italic;
  }

  .post-body blockquote p:last-child { margin-bottom: 0; }
  .post-body strong { font-weight: var(--font-weight-semibold); }

  /* ─── News item ─── */
  .news-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .news-item:last-child { border-bottom: none; }

  .news-source {
    font-size: 0.72rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    color: var(--gold-dark);
    background: color-mix(in srgb, var(--gold) 15%, transparent);
    padding: 3px 8px;
    border-radius: 3px;
    white-space: nowrap;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .news-title {
    font-weight: var(--font-weight-medium);
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.45;
  }

  .news-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ─── GitHub card ─── */
  .github-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin: 8px 0;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s var(--ease);
  }

  .github-card:hover {
    border-color: var(--gold);
    background: var(--bg-cream);
    opacity: 1;
  }

  .github-name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--gold-dark);
    font-family: 'Jost', monospace;
  }

  .github-stars {
    font-size: 0.78rem;
    color: #c97d3a;
    font-weight: var(--font-weight-semibold);
    flex-shrink: 0;
  }

  /* ─── Sources footer ─── */
  .sources-box {
    margin-top: 56px;
    padding: 28px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .sources-box h4 {
    font-size: 0.7rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 14px;
  }

  .sources-box a {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--gold-dark);
    margin: 4px 16px 4px 0;
    font-weight: var(--font-weight-medium);
  }

  .sources-box a:hover { opacity: 0.7; }

  .sources-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 12px;
    margin-bottom: 0;
  }

