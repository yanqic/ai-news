---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>">
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    --bg-primary: #f8f7f4;
    --bg-secondary: #ffffff;
    --bg-card: #ffffff;
    --text-primary: #1a1a1a;
    --text-secondary: #6b6b6b;
    --text-muted: #999999;
    --accent-color: #2563eb;
    --accent-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --border-color: #e8e6e1;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
    --shadow-lg: 0 8px 30px rgba(0,0,0,0.12);
    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 20px;
  }

  [data-theme="dark"] {
    --bg-primary: #0f0f12;
    --bg-secondary: #18181c;
    --bg-card: #1e1e24;
    --text-primary: #e8e6e1;
    --text-secondary: #9ca3af;
    --text-muted: #6b7280;
    --accent-color: #818cf8;
    --accent-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    --border-color: #2d2d35;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.4);
    --shadow-lg: 0 8px 30px rgba(0,0,0,0.5);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Noto Sans SC', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    line-height: 1.7;
    background: var(--bg-primary);
    color: var(--text-primary);
    transition: background 0.3s, color 0.3s;
    -webkit-font-smoothing: antialiased;
  }

  /* ─── Navigation ─── */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 16px;
    margin-bottom: 0;
    background: var(--bg-primary);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .nav-brand-icon {
    width: 36px;
    height: 36px;
    background: var(--accent-gradient);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .nav-brand-text {
    font-size: 1.05em;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9em;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    transition: all 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .theme-toggle {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.85em;
    font-weight: 500;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .theme-toggle:hover {
    background: var(--border-color);
    color: var(--text-primary);
  }

  /* ─── Typography ─── */
  h1, h2, h3, h4 {
    color: var(--text-primary);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  h1 { font-size: 2em; }
  h2 {
    font-size: 1.4em;
    margin-top: 36px;
    margin-bottom: 16px;
  }
  h3 { font-size: 1.15em; margin-bottom: 12px; }

  p { margin-bottom: 12px; }

  a {
    color: var(--accent-color);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  a:hover { opacity: 0.75; }

  /* ─── Lists (news items) ─── */
  .news-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .news-item {
    padding: 18px 0;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .news-item:last-child { border-bottom: none; }

  .news-source {
    font-size: 0.75em;
    font-weight: 600;
    color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 12%, transparent);
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
    margin-top: 2px;
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }

  .news-content {
    flex: 1;
    min-width: 0;
  }

  .news-title {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .news-desc {
    font-size: 0.9em;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ─── GitHub items ─── */
  .github-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    margin: 8px 0;
    gap: 12px;
    transition: all 0.2s;
    text-decoration: none;
    color: var(--text-primary);
  }

  .github-item:hover {
    border-color: var(--accent-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
    opacity: 1;
  }

  .github-name {
    font-weight: 600;
    font-size: 0.95em;
    color: var(--accent-color);
    font-family: 'Inter', monospace;
  }

  .github-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .github-stars {
    font-size: 0.8em;
    color: #f97316;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .github-arrow {
    color: var(--text-muted);
    font-size: 0.8em;
  }

  /* ─── Section headers ─── */
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .section-label::before {
    content: '';
    display: block;
    width: 20px;
    height: 2px;
    background: var(--accent-color);
    border-radius: 1px;
  }

  /* ─── Footer ─── */
  .site-footer {
    margin-top: 80px;
    padding: 40px 0;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.85em;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  .footer-sources a {
    color: var(--text-secondary);
    margin-right: 12px;
    font-size: 0.9em;
  }

  .footer-sources a:hover { color: var(--accent-color); opacity: 1; }

  /* ─── Content page ─── */
  .post-header {
    padding: 48px 0 32px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 40px;
  }

  .post-header .post-date {
    font-size: 0.85em;
    color: var(--text-muted);
    margin-bottom: 12px;
    font-weight: 500;
  }

  .post-header h1 {
    font-size: 2.2em;
    line-height: 1.2;
    margin-bottom: 0;
    border: none;
    padding: 0;
    background: none;
  }

  .post-header .post-desc {
    margin-top: 12px;
    color: var(--text-secondary);
    font-size: 1.05em;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9em;
    font-weight: 500;
    padding: 8px 0;
    margin-bottom: 24px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-color);
    opacity: 1;
  }

  /* ─── Misc ─── */
  .source-tag {
    color: var(--text-muted);
    font-size: 0.85em;
  }

  .empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 80px 20px;
    font-size: 1.1em;
  }

  @media (max-width: 640px) {
    body { padding: 0 16px; }
    h1 { font-size: 1.6em; }
    h2 { font-size: 1.2em; }
    .nav-brand-text { font-size: 0.95em; }
    .post-header { padding: 32px 0 24px; }
    .post-header h1 { font-size: 1.7em; }
    .footer-inner { flex-direction: column; }
  }
</style>

<script>
  function toggleTheme() {
    const html = document.documentElement;
    const btn = document.querySelector('.theme-toggle');
    const label = btn.querySelector('.theme-label');
    if (html.getAttribute('data-theme') === 'dark') {
      html.removeAttribute('data-theme');
      if (label) label.textContent = '深色模式';
      localStorage.setItem('theme', 'light');
    } else {
      html.setAttribute('data-theme', 'dark');
      if (label) label.textContent = '浅色模式';
      localStorage.setItem('theme', 'dark');
    }
  }

  (function() {
    const saved = localStorage.getItem('theme');
    if (saved === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else if (saved === 'light') {
      document.documentElement.removeAttribute('data-theme');
    } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  })();
</script>
