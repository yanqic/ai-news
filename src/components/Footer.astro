---
// src/components/Footer.astro
import { SITE_SOCIAL, COPYRIGHT } from '@/data/site-config';
---
<footer class="border-t border-gray-200 dark:border-gray-700 mt-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        {COPYRIGHT}
      </p>
      <div class="flex space-x-4 mt-4 sm:mt-0">
        {Object.entries(SITE_SOCIAL).map(([platform, url]) => (
          <a 
            key={platform}
            href={url} 
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
            aria-label={`Follow us on ${platform}`}
          >
            {/* Simple icon placeholders - in reality you'd use proper icon components */}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              {platform === 'twitter' && <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>}
              {platform === 'github' && <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>}
              {platform === 'linkedin' && <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>}
              {platform === 'instagram' && <path d="M4.4 22.3a17.3 17.3 0 0 1 14.2 0c1.5-.5 2.8-1.2 3.7-2.2l1.6-3.9a1 1 0 0 0-.3-.9l-1.4-.8a1 1 0 0 0-.9-.3l-3.9 1.6a17.3 17.3 0 0 1-2.2-3.7 17.3 17.3 0 0 1 0-14.2c.5-1.5 1.2-2.8 2.2-3.7l3.9-1.6a1 1 0 0 0 .9-.3l-.8-1.4a1 1 0 0 0-.3-.9l-1.6 3.9a17.3 17.3 0 0 1-3.7 2.2 17.3 17.3 0 0 1-14.2 0c-1.5.5-2.8 1.2-3.7 2.2l-1.6 3.9a1 1 0 0 0 .3.9l1.4.8a1 1 0 0 0 .9.3l3.9-1.6c.5 1.5 1.2 2.8 2.2 3.7z"/>}
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>