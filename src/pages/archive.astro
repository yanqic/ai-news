---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const grouped = sortedPosts.reduce((acc, post) => {
  const key = post.data.pubDate.toISOString().slice(0, 7);
  if (!acc[key]) acc[key] = [];
  acc[key].push(post);
  return acc;
}, {} as Record<string, typeof posts>);

const months = Object.keys(grouped).sort((a, b) => b.localeCompare(a));
---

<Layout title="历史存档 - AI新闻简报" description="AI新闻简报历史文章存档">
  <!-- Navigation -->
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">
        <div class="nav-brand-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="#001f1f" stroke-width="2"/>
            <path d="M12 6v6l4 2" stroke="#001f1f" stroke-width="2" stroke-linecap="round"/>
            <circle cx="12" cy="12" r="2" fill="#001f1f"/>
          </svg>
        </div>
        <span>AI新闻简报</span>
      </a>
      <div class="nav-links">
        <a href="/">首页</a>
        <a href="/archive" class="active">历史存档</a>
      </div>

    </div>
  </nav>

  <!-- Dark Archive Hero -->
  <section class="archive-hero">
    <div class="page-container">
      <p class="hero-eyebrow">全部文章</p>
      <h1>历史存档</h1>
      <p>共 {sortedPosts.length} 期内容</p>
    </div>
  </section>

  <!-- Archive List -->
  <section class="archive-section">
    <div class="page-container">
      {sortedPosts.length === 0 ? (
        <div class="empty-state">暂无内容</div>
      ) : (
        months.map(month => (
          <div class="archive-group">
            <div class="archive-month-label">{month}</div>
            <div class="archive-list">
              {grouped[month].map(post => {
                const cat = post.data.category || 'news';
                return (
                <a href={`/posts/${post.slug}`} class="archive-item">
                  <span class="archive-item-date">{post.data.pubDate.toISOString().slice(8, 10)}日</span>
                  <span class={`archive-item-cat ${cat}`}>{cat === 'github' ? 'GitHub' : 'AI新闻'}</span>
                  <span class="archive-item-title">{post.data.title}</span>
                  <span class="archive-item-arrow">→</span>
                </a>
                );
              })}
            </div>
          </div>
        ))
      )}
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="#bfb29c" stroke-width="2"/>
            <path d="M12 6v6l4 2" stroke="#bfb29c" stroke-width="2" stroke-linecap="round"/>
            <circle cx="12" cy="12" r="2" fill="#bfb29c"/>
          </svg>
          <span>AI新闻简报</span>
        </div>
        <p class="footer-note">由 AI 自动聚合 · 每日更新</p>
      </div>
      <div class="footer-links">
        <a href="https://news.aibase.com/zh" target="_blank" rel="noopener">AIBase</a>
        <a href="https://jiqizhixin.com" target="_blank" rel="noopener">机器之心</a>
        <a href="https://xinzhiyuan.ai" target="_blank" rel="noopener">新智元</a>
        <a href="https://blog.google/technology/ai/" target="_blank" rel="noopener">Google AI</a>
        <a href="https://github.com/trending" target="_blank" rel="noopener">GitHub Trending</a>
      </div>
    </div>
  </footer>
</Layout>
