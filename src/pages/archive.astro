---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout title="AI新闻简报 - 每日AI行业资讯" description="每日AI新闻简报，汇集AIBase、机器之心、新智元、Google AI Blog等来源的AI行业资讯。">
  <div class="nav">
    <a href="/">首页</a>
    <a href="/archive">历史存档</a>
    <button class="theme-toggle" onclick="toggleTheme()" aria-label="切换主题">🌙 暗色模式</button>
  </div>

  <h1>📁 历史存档</h1>
  <div class="archive-list">
    {sortedPosts.length === 0 ? (
      <p class="empty">暂无历史存档...</p>
    ) : (
      sortedPosts.map(post => (
        <div class="archive-item">
          <a href={`/posts/${post.slug}`}>📰 {post.data.date}</a>
        </div>
      ))
    )}
  </div>

  <div class="footer">
    <p>AI新闻来源：<a href="https://www.aibase.com/" target="_blank" rel="noopener">AIBase</a>、<a href="https://jiqizhixin.com/" target="_blank" rel="noopener">机器之心</a>、<a href="https://ai.ua.edu.cn/" target="_blank" rel="noopener">新智元</a>、<a href="https://blog.google/technology/ai/" target="_blank" rel="noopener">Google AI Blog</a></p>
    <p>GitHub数据来源：<a href="https://github.com/trending" target="_blank" rel="noopener">github.com/trending</a></p>
  </div>
</Layout>

<style>
.archive-list {
  background: var(--bg-secondary);
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 1px 3px var(--shadow);
}

.archive-item {
  padding: 12px 0;
  border-bottom: 1px solid var(--border-color);
}

.archive-item:last-child { border-bottom: none; }

.archive-item a {
  color: var(--accent-color);
  text-decoration: none;
  font-weight: 500;
  display: block;
  padding: 8px 0;
}

.archive-item a:hover {
  text-decoration: underline;
  transform: translateX(4px);
  transition: transform 0.2s;
}

.empty { color: var(--text-secondary); font-style: italic; }
</style>
