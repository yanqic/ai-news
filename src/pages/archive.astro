---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="历史存档 - AI新闻简报" description="AI新闻简报历史文章存档">
  <!-- Navigation -->
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">
        <div class="nav-brand-icon">🤖</div>
        <span>AI新闻简报</span>
      </a>
      <div class="nav-links">
        <a href="/">首页</a>
        <a href="/archive" class="active">历史存档</a>
      </div>
      <div class="nav-right">
        <button class="theme-toggle" onclick="toggleTheme()" aria-label="切换主题">☀️</button>
      </div>
    </div>
  </nav>

  <main>
    <div class="page-container">
      <!-- Archive header -->
      <section class="archive-header">
        <h1>历史存档</h1>
        <p>共 {sortedPosts.length} 期内容</p>
      </section>

      <!-- Archive list -->
      <div class="posts-section">
        {sortedPosts.length === 0 ? (
          <div class="empty-state">暂无内容</div>
        ) : (
          <div class="posts-list">
            {sortedPosts.map(post => {
              const date = post.data.pubDate.toISOString().slice(0, 10);
              return (
                <a href={`/posts/${post.slug}`} class="post-list-item">
                  <span class="post-list-item-date">{date}</span>
                  <span class="post-list-item-title">{post.data.title}</span>
                  <span class="post-list-item-arrow">→</span>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">
          <span>🤖</span>
          <span>AI新闻简报</span>
        </div>
        <p class="footer-note">由 AI 自动聚合 · 每日更新</p>
      </div>
      <div class="footer-links">
        <a href="https://news.aibase.com/zh" target="_blank" rel="noopener">AIBase</a>
        <a href="https://jiqizhixin.com" target="_blank" rel="noopener">机器之心</a>
        <a href="https://xinzhiyuan.ai" target="_blank" rel="noopener">新智元</a>
        <a href="https://blog.google/technology/ai/" target="_blank" rel="noopener">Google AI</a>
        <a href="https://github.com/trending" target="_blank" rel="noopener">GitHub Trending</a>
      </div>
    </div>
  </footer>
</Layout>
