---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const postDate = post.data.pubDate.toISOString().slice(0, 10);
const cat = post.data.category || 'news';
---

<Layout title={`${post.data.title} - AI新闻简报`} description={post.data.description}>
  <!-- Navigation -->
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">
        <div class="nav-brand-icon">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
            <path d="M12 8H22V24" stroke="#001f1f" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M10 10 H20 V25 L10 23.2 Z" fill="#001f1f" stroke="#001f1f" stroke-width="0.4" stroke-linejoin="round"/>
          </svg>
        </div>
        <span>AI新闻简报</span>
      </a>
      <div class="nav-links">
        <a href="/">首页</a>
        <a href="/archive">历史存档</a>
      </div>

    </div>
  </nav>

  <!-- Cover image -->
  {post.data.image?.url && (
    <div class="article-cover">
      <img src={post.data.image.url} alt={post.data.image.alt || post.data.title} />
    </div>
  )}

  <!-- Content area (cream) -->
  <div class="post-page">
    <div class="post-page-inner">
      <a href="/" class="post-back">← 返回首页</a>

      <header class="post-header">
        <div class="post-meta">
          <span class={`post-cat-badge ${cat}`}>{cat === 'github' ? 'GitHub Trending' : 'AI新闻'}</span>
          <span class="post-date">{postDate}</span>
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        {post.data.description && (
          <p class="post-description">{post.data.description}</p>
        )}
      </header>

      <article class="post-body">
        <Content />
      </article>

      <footer class="sources-box">
        <h4>数据来源</h4>
        <a href="https://news.aibase.com/zh" target="_blank" rel="noopener">AIBase</a>
        <a href="https://jiqizhixin.com" target="_blank" rel="noopener">机器之心</a>
        <a href="https://xinzhiyuan.ai" target="_blank" rel="noopener">新智元</a>
        <a href="https://blog.google/technology/ai/" target="_blank" rel="noopener">Google AI Blog</a>
        <a href="https://github.com/trending" target="_blank" rel="noopener">GitHub Trending</a>
        <p class="sources-note">以上内容由 AI 自动聚合摘要，如有侵权请联系删除。</p>
      </footer>
    </div>
  </div>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">
          <svg width="16" height="16" viewBox="0 0 32 32" fill="none">
            <path d="M12 8H22V24" stroke="#bfb29c" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M10 10 H20 V25 L10 23.2 Z" fill="#bfb29c" stroke="#bfb29c" stroke-width="0.4" stroke-linejoin="round"/>
          </svg>
          <span>AI新闻简报</span>
        </div>
        <p class="footer-note">由 AI 自动聚合 · 每日更新</p>
      </div>
      <div class="footer-links">
        <a href="https://news.aibase.com/zh" target="_blank" rel="noopener">AIBase</a>
        <a href="https://jiqizhixin.com" target="_blank" rel="noopener">机器之心</a>
        <a href="https://xinzhiyuan.ai" target="_blank" rel="noopener">新智元</a>
        <a href="https://blog.google/technology/ai/" target="_blank" rel="noopener">Google AI</a>
        <a href="https://github.com/trending" target="_blank" rel="noopener">GitHub Trending</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Article cover image */
  .article-cover {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
    background: var(--green-deep);
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    max-height: 420px;
    object-fit: cover;
    display: block;
  }

  /* Post page */
  .post-page {
    background: var(--bg-cream);
    padding: var(--space-xl) var(--space-lg);
  }

  .post-page-inner {
    max-width: var(--max-w-narrow);
    margin: 0 auto;
  }

  .post-back {
    display: inline-flex;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: var(--space-lg);
    transition: color 0.2s;
  }

  .post-back:hover { color: var(--gold); }

  .post-header {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-lg);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
    line-height: 1;
  }

  .post-cat-badge {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 3px;
    background: var(--green-deep);
    color: var(--gold);
    align-self: center;
  }

  .post-cat-badge.github {
    background: #2d1f00;
    color: #f0c040;
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    align-self: center;
    margin-bottom: 0 !important;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 14px;
  }

  .post-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    font-weight: 300;
  }

  /* Article body prose */
  .post-body {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .post-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 2em 0 0.8em;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .post-body :global(h3) {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 1.5em 0 0.6em;
  }

  .post-body :global(p) {
    margin-bottom: 1em;
  }

  .post-body :global(ul), .post-body :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1em;
  }

  .post-body :global(li) {
    margin-bottom: 0.4em;
    line-height: 1.7;
  }

  .post-body :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }

  .post-body :global(a) {
    color: var(--gold-dark);
    border-bottom: 1px solid var(--gold);
    transition: color 0.2s;
  }

  .post-body :global(a:hover) {
    color: var(--gold);
  }

  .post-body :global(code) {
    font-family: 'Courier New', monospace;
    font-size: 0.875em;
    background: var(--bg-cream);
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding-left: 1.2em;
    margin: 1.5em 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2em 0;
  }

  /* Sources */
  .sources-box {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    align-items: center;
  }

  .sources-box h4 {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    width: 100%;
    margin: 0;
  }

  .sources-box a {
    font-size: 0.8rem;
    color: var(--gold-dark);
    border-bottom: 1px solid transparent;
    transition: all 0.2s;
  }

  .sources-box a:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  .sources-note {
    font-size: 0.72rem;
    color: var(--text-muted);
    width: 100%;
    margin: 0;
  }

  @media (max-width: 640px) {
    .article-cover { max-height: 220px; }
    .article-cover img { max-height: 220px; }
    .post-page { padding: 20px 16px 56px; }
    .post-page-inner { padding: 0; }
    .post-title { font-size: 1.6rem; }
    .post-body { font-size: 0.9rem; }
    .post-body :global(h2) { font-size: 1.2rem; }
    .sources-box { padding: 20px 0 0; padding-left: 16px; }
  }

  @media (max-width: 480px) {
    .post-meta { flex-direction: column; align-items: flex-start; gap: 6px; }
    .post-back { font-size: 0.7rem; }
  }
</style>
