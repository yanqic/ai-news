---
// src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HERO_SECTION } from '@/data/site-config';
---
<BaseLayout>
  <section class="text-center py-12">
    <div class="text-6xl mb-8">🤖</div>
    <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
      {HERO_SECTION.title}
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
      {HERO_SECTION.text}
    </p>
    <div class="flex flex-col sm:flex-row sm:justify-center space-y-4 sm:space-y-0 sm:space-x-4">
      {HERO_SECTION.buttons.map((button, index) => (
        <a
          key={index}
          href={button.url}
          class={`px-6 py-3 rounded-lg font-medium transition-all duration-300 ${
            button.variant === 'primary'
              ? 'bg-primary-600 text-white hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-400'
              : 'border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800'
          }`}
        >
          {button.text}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>