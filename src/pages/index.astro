---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="AI新闻简报 - 每日AI行业资讯" description="每日AI新闻简报，汇集AIBase、机器之心、新智元、Google AI Blog等来源的AI行业资讯。">
  <!-- Navigation -->
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">
        <div class="nav-brand-icon">🤖</div>
        <span>AI新闻简报</span>
      </a>
      <div class="nav-links">
        <a href="/" class="active">首页</a>
        <a href="/archive">历史存档</a>
      </div>
      <div class="nav-right">
        <button class="theme-toggle" onclick="toggleTheme()" aria-label="切换主题" title="切换主题">☀️</button>
      </div>
    </div>
  </nav>

  <main>
    <div class="page-container">
      <!-- Hero -->
      <section class="blog-hero">
        <div class="blog-hero-inner">
          <h1>AI新闻简报</h1>
          <p>每日追踪 AIBase、机器之心、新智元、Google AI Blog 等来源的AI行业动态，与 GitHub Trending 热门项目推荐。</p>
        </div>
      </section>

      <!-- Category filters -->
      <div class="category-filters">
        <button class="category-pill active" data-category="all">全部</button>
        <button class="category-pill" data-category="news">每日AI新闻</button>
        <button class="category-pill" data-category="github">GitHub Trending</button>
      </div>

      <!-- Toolbar -->
      <div class="section-toolbar">
        <span class="section-count">{sortedPosts.length} 期内容</span>
        <div style="display:flex;gap:8px;align-items:center;">
          <div class="view-toggle">
            <button class="active" id="grid-view-btn" title="网格视图" aria-label="网格视图">⊞</button>
            <button id="list-view-btn" title="列表视图" aria-label="列表视图">≡</button>
          </div>
        </div>
      </div>

      <!-- Posts grid -->
      <div class="posts-section">
        {sortedPosts.length === 0 ? (
          <div class="empty-state">暂无内容</div>
        ) : (
          <div class="posts-grid" id="posts-grid">
            {sortedPosts.map(post => {
              const date = post.data.pubDate.toISOString().slice(0, 10);
              return (
                <a href={`/posts/${post.slug}`} class="post-card" data-date={date}>
                  <div class="post-card-meta">
                    <span class="post-card-date">{date}</span>
                  </div>
                  <div class="post-card-title">{post.data.title}</div>
                  <div class="post-card-excerpt">{post.data.description || '每日AI新闻摘要及GitHub Trending热榜项目推荐。'}</div>
                  <div class="post-card-footer">
                    <span class="post-card-sources">AIBase · 机器之心 · 新智元</span>
                    <span class="read-more-link">阅读 →</span>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">
          <span>🤖</span>
          <span>AI新闻简报</span>
        </div>
        <p class="footer-note">由 AI 自动聚合 · 每日更新</p>
      </div>
      <div class="footer-links">
        <a href="https://news.aibase.com/zh" target="_blank" rel="noopener">AIBase</a>
        <a href="https://jiqizhixin.com" target="_blank" rel="noopener">机器之心</a>
        <a href="https://xinzhiyuan.ai" target="_blank" rel="noopener">新智元</a>
        <a href="https://blog.google/technology/ai/" target="_blank" rel="noopener">Google AI</a>
        <a href="https://github.com/trending" target="_blank" rel="noopener">GitHub Trending</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Hidden list view — toggled via JS */
  .posts-list { display: none; }
</style>

<script>
  const gridBtn = document.getElementById('grid-view-btn');
  const listBtn = document.getElementById('list-view-btn');
  const grid = document.getElementById('posts-grid');

  function showGrid() {
    if (!grid) return;
    grid.style.display = 'grid';
    grid.classList.remove('posts-list');
    grid.style.gridTemplateColumns = 'repeat(3, 1fr)';
    grid.querySelectorAll('.post-card').forEach(card => {
      (card as HTMLElement).style.display = '';
    });
    gridBtn.classList.add('active');
    listBtn.classList.remove('active');
  }

  function showList() {
    if (!grid) return;
    grid.style.display = 'flex';
    grid.style.flexDirection = 'column';
    grid.style.gridTemplateColumns = '';
    grid.querySelectorAll('.post-card').forEach((card, i) => {
      const el = card as HTMLElement;
      el.style.display = 'flex';
      el.style.flexDirection = 'row';
      el.style.alignItems = 'center';
      el.style.gap = '20px';
      // date + title + arrow layout
      const meta = card.querySelector('.post-card-meta');
      const title = card.querySelector('.post-card-title');
      const excerpt = card.querySelector('.post-card-excerpt');
      const footer = card.querySelector('.post-card-footer');
      if (meta) (meta as HTMLElement).style.display = '';
      if (excerpt) (excerpt as HTMLElement).style.display = 'none';
      if (footer) (footer as HTMLElement).style.display = 'none';
    });
    listBtn.classList.add('active');
    gridBtn.classList.remove('active');
  }

  gridBtn.addEventListener('click', showGrid);
  listBtn.addEventListener('click', showList);
</script>
