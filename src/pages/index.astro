---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const newsPosts = sortedPosts.filter(p => p.data.category === 'news');
const githubPosts = sortedPosts.filter(p => p.data.category === 'github');
---

<Layout title="AI新闻简报 - 每日AI行业资讯" description="每日AI新闻简报，汇集AIBase、机器之心、新智元、Google AI Blog等来源的AI行业资讯。">
  <!-- Navigation -->
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">
        <div class="nav-brand-icon">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
            <path d="M12 8H22V24" stroke="#001f1f" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M10 10 H20 V25 L10 23.2 Z" fill="#001f1f" stroke="#001f1f" stroke-width="0.4" stroke-linejoin="round"/>
          </svg>
        </div>
        <span>AI新闻简报</span>
      </a>
      <div class="nav-links">
        <a href="/" class="active">首页</a>
        <a href="/archive">历史存档</a>
      </div>
      <!-- Mobile hamburger menu -->
      <button class="hamburger" id="hamburger-btn" aria-label="菜单">
        <span></span><span></span><span></span>
      </button>
      <!-- Mobile dropdown -->
      <div class="mobile-menu" id="mobile-menu">
        <div class="mobile-menu-header">选择分类</div>
        <a href="/" class="mobile-menu-item active" data-cat="all">全部</a>
        <a href="/?cat=news" class="mobile-menu-item" data-cat="news">每日AI新闻</a>
        <a href="/?cat=github" class="mobile-menu-item" data-cat="github">GitHub Trending</a>
      </div>
    </div>
  </nav>

  <!-- Dark Hero -->
  <section class="hero-section">
    <div class="page-container">
      <div class="hero-inner">
        <p class="hero-eyebrow">每日更新 · AI聚合</p>
        <h1 class="hero-title">AI新闻简报</h1>
        <div class="hero-divider"></div>
        <p class="hero-subtitle">
          追踪 AIBase、机器之心、新智元、Google AI Blog 等来源的AI行业动态，
          与 GitHub Trending 热门项目推荐。
        </p>
      </div>
    </div>
  </section>

  <!-- Category Links (cream) -->
  <section class="category-bar">
    <div class="page-container">
      <div class="category-inner">
        <a href="/" class="category-link active" data-cat="all">全部</a>
        <a href="/?cat=news" class="category-link" data-cat="news">每日AI新闻</a>
        <a href="/?cat=github" class="category-link" data-cat="github">GitHub Trending</a>
        <div class="view-toggle">
          <button class="active" id="grid-btn" title="网格视图">⊞</button>
          <button id="list-btn" title="列表视图">≡</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Posts -->
  <section class="posts-section">
    <div class="page-container">
      <div class="posts-grid" id="posts-grid">
        {sortedPosts.map((post) => {
          const date = post.data.pubDate.toISOString().slice(0, 10);
          const cat = post.data.category || 'news';
          return (
            <a href={`/posts/${post.slug}`} class="post-card" data-cat={cat}>
              <div class="post-card-image">
                {post.data.image?.url ? (
                  <img src={post.data.image.url} alt={post.data.image.alt || post.data.title} loading="lazy" />
                ) : (
                  <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&q=80"
                       alt="AI News" loading="lazy" />
                )}
                <span class={`post-card-badge ${cat}`}>{cat === 'github' ? 'GitHub' : 'AI新闻'}</span>
              </div>
              <div class="post-card-body">
                <span class="post-card-date">{date}</span>
                <h3 class="post-card-title">{post.data.title}</h3>
                <p class="post-card-excerpt">{post.data.description || ''}</p>
                <div class="post-card-footer">
                  <span class="read-link">阅读 →</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">
          <svg width="16" height="16" viewBox="0 0 32 32" fill="none">
            <path d="M12 8H22V24" stroke="#bfb29c" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M10 10 H20 V25 L10 23.2 Z" fill="#bfb29c" stroke="#bfb29c" stroke-width="0.4" stroke-linejoin="round"/>
          </svg>
          <span>AI新闻简报</span>
        </div>
        <p class="footer-note">由 AI 自动聚合 · 每日更新</p>
      </div>
      <div class="footer-links">
        <a href="https://news.aibase.com/zh" target="_blank" rel="noopener">AIBase</a>
        <a href="https://jiqizhixin.com" target="_blank" rel="noopener">机器之心</a>
        <a href="https://xinzhiyuan.ai" target="_blank" rel="noopener">新智元</a>
        <a href="https://blog.google/technology/ai/" target="_blank" rel="noopener">Google AI</a>
        <a href="https://github.com/trending" target="_blank" rel="noopener">GitHub Trending</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* ── Category bar ── */
  .category-bar {
    background: var(--bg-cream);
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: var(--nav-h);
    z-index: 90;
  }

  .category-inner {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .category-inner::-webkit-scrollbar { display: none; }

  .category-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 20px;
    white-space: nowrap;
    transition: all 0.2s var(--ease);
    text-decoration: none;
    flex-shrink: 0;
  }

  .category-link:hover {
    border-color: var(--gold);
    color: var(--text-primary);
  }

  .category-link.active {
    background: var(--green-deep);
    border-color: var(--green-deep);
    color: var(--gold);
  }

  .view-toggle {
    margin-left: auto;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px;
  }

  .view-toggle button {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    border-radius: 3px;
    cursor: pointer;
    color: var(--text-muted);
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s var(--ease);
  }

  .view-toggle button.active {
    background: var(--green-deep);
    color: var(--gold);
  }

  /* ── Posts section ── */
  .posts-section {
    padding: var(--space-xl) 0 var(--space-2xl);
    background: var(--bg-cream);
    min-height: 50vh;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* ── Post Card ── */
  .post-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s var(--ease);
  }

  .post-card:hover {
    border-color: var(--gold);
    box-shadow: 0 8px 32px rgba(0,31,31,0.1);
    transform: translateY(-3px);
  }

  .post-card[data-cat]:not([data-cat="all"]) {
    display: flex;
  }

  .post-card-image {
    position: relative;
    height: 160px;
    background: var(--bg-cream);
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .post-card:hover .post-card-image img {
    transform: scale(1.04);
  }

  .post-card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    background: var(--green-deep);
    color: var(--gold);
  }

  .post-card-badge.github {
    background: #2d1f00;
    color: #f0c040;
  }

  .post-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
  }

  .post-card-date {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-dark);
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--text-primary);
    flex: 1;
  }

  .post-card-excerpt {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .read-link {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-dark);
    transition: gap 0.2s var(--ease);
  }

  .post-card:hover .read-link { gap: 8px; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
    .hero-section { padding: 48px 0; }
    .hero-title { font-size: clamp(2rem, 6vw, 3rem); }
    .nav-inner { padding: 0 20px; }
    .page-container { padding: 0 20px; }
  }

  @media (max-width: 640px) {
    .site-nav { height: 56px; }
    .category-bar { top: 56px; position: sticky; }
    .posts-grid { grid-template-columns: 1fr; gap: 16px; }
    .hero-section { padding: 36px 0; }
    .hero-title { font-size: 2rem; }
    .hero-subtitle { font-size: 0.875rem; }
    .page-container { padding: 0 16px; }
    .category-bar { padding: 10px 0; }
    .category-link { font-size: 0.72rem; padding: 5px 12px; }
    .post-card-body { padding: 16px; }
    .post-card-title { font-size: 0.975rem; }
    .site-footer { padding: 32px 0; }
    .footer-inner { flex-direction: column; gap: 20px; padding: 0 16px; }
    .footer-links { gap: 6px 16px; }
  }

  /* ── Mobile nav ── */
  @media (max-width: 480px) {
    .nav-links { display: none; }
    .nav-brand span { font-size: 0.95rem; }
    .hero-inner { max-width: 100%; }
    .posts-section { padding: 24px 0 64px; }
  }

  /* ── Hamburger button ── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--green-line);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0 8px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--gold);
    border-radius: 2px;
    transition: all 0.3s var(--ease);
  }

  .hamburger.active span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ── Mobile dropdown menu ── */
  .mobile-menu {
    display: none;
    position: absolute;
    top: var(--nav-h, 68px);
    left: 0;
    right: 0;
    background: var(--bg-dark);
    border-bottom: 1px solid var(--green-line);
    padding: 8px 0 16px;
    z-index: 200;
    flex-direction: column;
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-menu-header {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    padding: 8px 20px 12px;
    border-bottom: 1px solid var(--green-line);
    margin-bottom: 8px;
  }

  .mobile-menu-item {
    display: block;
    padding: 10px 20px;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--gold);
    text-decoration: none;
    transition: all 0.2s;
  }

  .mobile-menu-item:hover,
  .mobile-menu-item.active {
    background: var(--green-line);
    color: var(--cream);
  }

  @media (max-width: 480px) {
    .hamburger { display: flex; }
    .nav-inner { position: relative; }
  }
</style>

<script>
  // ── View toggle ──
  const gridBtn = document.getElementById('grid-btn') as HTMLButtonElement;
  const listBtn = document.getElementById('list-btn') as HTMLButtonElement;
  const grid = document.getElementById('posts-grid') as HTMLElement;
  const cards = grid?.querySelectorAll('.post-card');

  function showGrid() {
    if (!grid || !cards) return;
    grid.style.display = 'grid';
    grid.style.gridTemplateColumns = 'repeat(3, 1fr)';
    cards.forEach(card => {
      const el = card as HTMLElement;
      el.style.display = '';
      el.style.flexDirection = '';
      const img = el.querySelector('.post-card-image') as HTMLElement;
      if (img) img.style.display = '';
    });
    gridBtn.classList.add('active');
    listBtn.classList.remove('active');
  }

  function showList() {
    if (!grid || !cards) return;
    grid.style.display = 'flex';
    grid.style.gridTemplateColumns = '';
    grid.style.flexDirection = 'column';
    cards.forEach(card => {
      const el = card as HTMLElement;
      el.style.display = 'flex';
      el.style.flexDirection = 'row';
      el.style.alignItems = 'center';
      const img = el.querySelector('.post-card-image') as HTMLElement;
      if (img) img.style.display = 'none';
    });
    listBtn.classList.add('active');
    gridBtn.classList.remove('active');
  }

  gridBtn?.addEventListener('click', showGrid);
  listBtn?.addEventListener('click', showList);

  // ── Category filter (client-side) ──
  function applyFilter(cat: string) {
    if (!cards) return;
    cards.forEach(card => {
      const el = card as HTMLElement;
      const cardCat = el.getAttribute('data-cat') || 'news';
      if (cat === 'all' || cardCat === cat) {
        el.style.display = '';
      } else {
        el.style.display = 'none';
      }
    });
  }

  function setActiveLink(cat: string) {
    document.querySelectorAll('.category-link').forEach(link => {
      const el = link as HTMLElement;
      el.classList.remove('active');
      if (el.getAttribute('data-cat') === cat) {
        el.classList.add('active');
      }
    });
    document.querySelectorAll('.mobile-menu-item').forEach(link => {
      const el = link as HTMLElement;
      el.classList.remove('active');
      if (el.getAttribute('data-cat') === cat) {
        el.classList.add('active');
      }
    });
  }

  const params = new URLSearchParams(window.location.search);
  const cat = params.get('cat') || 'all';
  applyFilter(cat);
  setActiveLink(cat);

  // Click handlers on category links (no page reload needed)
  document.querySelectorAll('.category-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const selectedCat = el.getAttribute('data-cat') || 'all';
      applyFilter(selectedCat);
      setActiveLink(selectedCat);
      closeMobileMenu();
      // Update URL without reload
      const url = new URL(window.location.href);
      if (selectedCat === 'all') {
        url.searchParams.delete('cat');
      } else {
        url.searchParams.set('cat', selectedCat);
      }
      window.history.replaceState({}, '', url.toString());
      e.preventDefault();
    });
  });

  // ── Mobile hamburger menu ──
  const hamburger = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function closeMobileMenu() {
    hamburger?.classList.remove('active');
    mobileMenu?.classList.remove('open');
  }

  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    mobileMenu?.classList.toggle('open');
  });

  // Mobile menu items also filter
  document.querySelectorAll('.mobile-menu-item').forEach(item => {
    item.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const selectedCat = el.getAttribute('data-cat') || 'all';
      applyFilter(selectedCat);
      setActiveLink(selectedCat);
      closeMobileMenu();
      const url = new URL(window.location.href);
      if (selectedCat === 'all') {
        url.searchParams.delete('cat');
      } else {
        url.searchParams.set('cat', selectedCat);
      }
      window.history.replaceState({}, '', url.toString());
      e.preventDefault();
    });
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.site-nav')) {
      closeMobileMenu();
    }
  });
</script>
